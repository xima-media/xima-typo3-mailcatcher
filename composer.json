{
	"name": "xima/xima-typo3-mailcatcher",
	"description": "Display mails that were send to log file",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"typo3-cms-extension",
		"mail"
	],
	"authors": [
		{
			"name": "Maik Schneider",
			"email": "maik.schneider@xima.de",
			"role": "Developer"
		}
	],
	"homepage": "https://www.xima.de",
	"require": {
		"php": "^8.1",
		"ext-json": "*",
		"typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
		"typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
		"typo3/cms-extbase": "^12.4 || ^13.4 || ^14.3",
		"typo3/cms-fluid": "^12.4 || ^13.4 || ^14.3",
		"zbateson/mail-mime-parser": "^2.0 || ^3.0"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^1.8 || ^2.2",
		"ergebnis/composer-normalize": "^2.54",
		"friendsofphp/php-cs-fixer": "^3.12",
		"helhum/typo3-console": "^8.1 || ^9.0",
		"move-elevator/composer-translation-validator": "^1.4",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^1.10 || ^2.0",
		"saschaegerer/phpstan-typo3": "^1.8 || ^2.0 || ^3.0",
		"ssch/typo3-rector": "^2.15 || ^3.0",
		"symfony/translation": "^6.4 || ^7.2",
		"typo3/cms-install": "^12.4 || ^13.4 || ^14.3",
		"typo3/testing-framework": "^8.2 || ^9.0"
	},
	"autoload": {
		"psr-4": {
			"Xima\\XimaTypo3Mailcatcher\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xima\\XimaTypo3Mailcatcher\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"ergebnis/composer-normalize": true,
			"helhum/typo3-console-plugin": true,
			"move-elevator/composer-translation-validator": true,
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"lock": false,
		"sort-packages": true,
		"vendor-dir": "vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "xima_typo3_mailcatcher",
			"version": "1.4.0",
			"web-dir": "public"
		}
	},
	"scripts": {
		"ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
		"ci:editorconfig:lint": "ec --strict --git-only -n",
		"ci:language:lint": "@composer validate-translations Resources/Private/Language",
		"ci:php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix --dry-run --format=checkstyle > php-cs-fixer.xml",
		"ci:php:lint": "find *.php . -name '*.php' ! -path './vendor/*' ! -path './var/*' ! -path '*node_modules/*' ! -path './public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:rector": "rector --dry-run",
		"ci:php:stan": "phpstan --no-progress --error-format=checkstyle > phpstan.xml",
		"ci:sca": [
			"@ci:composer:normalize",
			"@ci:editorconfig:lint",
			"@ci:php:lint",
			"@ci:php:rector",
			"@ci:php:fixer",
			"@ci:php:stan",
			"@ci:language:lint",
			"@ci:yaml:lint"
		],
		"ci:yaml:lint": "find ./ ! -path '*node_modules/*' ! -path './vendor/*' ! -path './public/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint",
		"composer:normalize": "@composer normalize --no-check-lock",
		"editorconfig:lint": "ec --strict --fix --git-only -n",
		"language:lint": "@composer validate-translations Resources/Private/Language",
		"php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix",
		"php:lint": "find *.php . -name '*.php' ! -path './vendor/*' ! -path './var/*' ! -path '*node_modules/*' ! -path './public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"php:rector": "rector",
		"php:stan": "phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"sca": [
			"@composer:normalize",
			"@editorconfig:lint",
			"@php:lint",
			"@php:rector",
			"@php:fixer",
			"@php:stan",
			"@language:lint",
			"@yaml:lint"
		],
		"test": [
			"@test:unit",
			"@test:functional"
		],
		"test:coverage": [
			"@test:coverage:unit",
			"@test:coverage:functional"
		],
		"test:coverage:functional": "phpunit -c phpunit.functional.xml --coverage-clover coverage/clover-functional.xml",
		"test:coverage:unit": "phpunit -c phpunit.unit.xml --coverage-clover coverage/clover-unit.xml",
		"test:functional": "phpunit -c phpunit.functional.xml",
		"test:unit": "phpunit -c phpunit.unit.xml",
		"yaml:lint": "find ./ ! -path '*node_modules/*' ! -path './vendor/*' ! -path './public/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint"
	}
}
