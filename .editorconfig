# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# JS files
[*.js]
indent_size = 2

# Comments and aligned attributes don't follow the indent size
[*.{css,html,ts}]
indent_size = unset

# JSON files
[*.json]
indent_style = tab

# npm and TypeScript configs
[{package.json,package-lock.json,tsconfig.json}]
indent_style = space
indent_size = 2

# ReST files
[{*.rst,*.rst.txt}]
indent_size = 4
max_line_length = 80

# SQL files
[*.sql]
indent_style = tab
indent_size = 2

# TypoScript files
[*.{typoscript,tsconfig}]
indent_size = 2

# YAML files
[{*.yml,*.yaml}]
indent_size = 2

# XLF files are generated/edited by tooling
[*.xlf]
indent_style = unset
indent_size = unset

# PHP formatting is owned by php-cs-fixer
[*.php]
indent_style = unset

# .htaccess
[.htaccess]
indent_style = tab

# Markdown files
[*.md]
indent_size = 2

# NEON files
[*.neon]
indent_style = tab
indent_size = 2

# Raw mails keep their original line endings and indentation
[Tests/**.log]
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

# DDEV files are managed by ddev
[.ddev/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
